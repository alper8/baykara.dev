---
// Page section components
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import Pill from '../components/Pill.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hello, my name is Alper Baykara"
					tagline="Software Developer & Data Modeler based in Istanbul, Turkey"
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="strategy" size="1.33em" /> System Architecture</Pill>
						<Pill><Icon icon="code" size="1.33em" /> Solution Design</Pill>
						<Pill><Icon icon="pencil-line" size="1.33em" /> Data Strategy</Pill>
					</div>
				</Hero>

				<img
					alt="Alper Baykara"
					width="480"
					height="620"
					src="/assets/portrait.png"
				/>
			</header>

			<Marquee />

			<Skills />
		</div>

		<main class="wrapper about">
			<section>
				<h2 class="section-title">Summary</h2>
				<div class="content">
					<p>
						I'm a Software Developer who thrives on solving complex problems at the intersection of business and technology. Over the last 2 years at Intellica, I've focused on dimensional modeling, data strategy, and end-to-end architecture — ensuring technical solutions align with business goals.
					</p>
					<p>
						I work directly with stakeholders to turn high-level strategy into scalable, well-architected solutions. My experience spans banking, IT, and financial data domains — designing systems that are both pragmatic and forward-looking.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Experience</h2>
				<div class="content">
					<h3>Intellica — Associate BI Consultant / Data Modeler</h3>
					<p><em>Aug 2024 – Jul 2026 · Istanbul, Turkey</em></p>
					<p>Started at Intellica's 2024 summer data training camp, hired part-time during university, then converted to full-time. Contributed to iterative advancement of key internal data frameworks including Intellica Financial (IFDM) and IT (ITDM) Data Models. Served as Data Modeler on Corporate Bank DWH Project (Reference available on request), driving data architecture decisions, ensuring data quality, and aligning deliverables with established modeling standards.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<h3>University of Pécs</h3>
					<p><em>Sep 2022 – Jul 2025 · Pécs, Hungary</em></p>
					<p>B.Sc. Computer Science — Software Developer track. Wrote thesis on creating an aviation company data warehouse. Completed relevant coursework in Data Science, Introduction to Artificial Intelligence, and Advanced Python.</p>
					<h3>ISTEK Schools</h3>
					<p><em>Sep 2020 – Jun 2022 · Istanbul, Turkey</em></p>
					<p>International Baccalaureate Diploma Programme with Higher Level Business Management and English.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills & Languages</h2>
				<div class="content">
					<p><strong>Technical:</strong> Data Architecture, Solution Design, Dimensional Modeling, Python, Oracle, Microsoft SQL Server, PowerDesigner, Financial Data Modeling</p>
					<p><strong>Languages:</strong> English (Professional Working Proficiency), Turkish (Native Proficiency)</p>
				</div>
			</section>
		</main>

		<ContactForm />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
		transition: box-shadow var(--theme-transition), transform var(--theme-transition);
	}

	.hero img:hover {
		box-shadow: var(--shadow-lg);
		transform: scale(1.01);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* About section styles */

	.about {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		color: var(--gray-200);
		padding: 1.75rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	section:hover {
		border-color: var(--gray-600);
		box-shadow: var(--shadow-md);
		transform: translateY(-1px);
	}

	.section-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		position: relative;
		padding-bottom: 0.5rem;
	}

	.section-title::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 2rem;
		height: 2px;
		background: var(--gradient-accent-orange);
		border-radius: 1px;
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		grid-column: 2 / 4;
	}

	.content h3 {
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--gray-0);
		margin-top: 0.25rem;
	}

	.content h3 + p {
		margin-top: -0.25rem;
	}

	.content em {
		font-style: normal;
		font-size: var(--text-sm);
		color: var(--gray-400);
		letter-spacing: 0.02em;
	}

	.content strong {
		color: var(--gray-100);
		font-weight: 600;
	}

	.content p {
		line-height: 1.7;
		color: var(--gray-300);
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
			gap: 3.5rem;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
			padding: 0;
			border: none;
			border-radius: 0;
			background: none;
			box-shadow: none;
		}

		section:hover {
			border-color: transparent;
			box-shadow: none;
			transform: none;
		}

		.section-title {
			font-size: var(--text-xl);
			padding-bottom: 0;
		}

		.section-title::after {
			display: none;
		}

		.content {
			display: block;
			gap: initial;
		}

		.content p {
			margin-bottom: 0.75rem;
		}

		.content h3 {
			font-size: var(--text-lg);
		}

		.content em {
			font-size: var(--text-base);
		}
	}
</style>
