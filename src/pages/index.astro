---
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>

  <section class="hero">
    <Hero />
  </section>

  <Skills />

  <!-- SUMMARY -->
  <section id="summary">
    <div class="section-label reveal">About</div>
    <h2 class="section-title reveal reveal-delay-1">Summary</h2>
    <div class="reveal reveal-delay-2 summary-grid">
      <p>
        I'm a Software Developer who thrives on solving complex problems at the intersection of business and technology. Over the last 2 years as a Data Modeler at Intellica, I've focused on dimensional modeling and end-to-end project execution, ensuring data quality and accuracy across banking, aviation, and IT domains.
      </p>
      <p>
        I believe in collaborative design and work directly with stakeholders to turn high-level strategy into scalable solutions. My background in Computer Science, combined with hands-on experience across financial and aviation data modeling, gives me a unique perspective on building systems that are both technically sound and business-aligned.
      </p>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience">
    <div class="section-label reveal">Experience</div>
    <h2 class="section-title reveal reveal-delay-1">Career</h2>
    <p class="section-sub reveal reveal-delay-2">My professional journey so far.</p>
    <div class="timeline reveal reveal-delay-3">
      <div class="timeline-item">
        <div class="date">Aug 2024 — Jul 2026</div>
        <h3>Associate BI Consultant / Data Modeler</h3>
        <div class="org">Intellica — Istanbul, Turkey</div>
        <p>Started at Intellica's 2024 summer data training camp, transitioned from part-time during university to full-time. Contributed to the iterative advancement of key internal data frameworks including IFDM (Financial) and ITDM (IT) Data Models. Worked on the Corporate Bank DWH Modernization Project, driving data quality and ensuring alignment with architectural standards.</p>
        <div class="tech-tags">
          <span>Python</span>
          <span>Oracle</span>
          <span>SQL Server</span>
          <span>PowerDesigner</span>
          <span>AI</span>
          <span>Banking</span>
        </div>
      </div>
    </div>

    <!-- Hidden Game Dev Section -->
    <div class="side-projects reveal">
      <div class="badge">&#127918; Side Quests</div>
      <h3>Creative Engineering</h3>
      <p>Beyond the data layer, I explore game development — building interactive experiences with Unity, C#, and a passion for crafting things people enjoy.</p>

      <div class="side-project-card">
        <div class="thumb">&#127922;</div>
        <div class="info">
          <h4>
            itch.io indie game project
            <span class="private-note" onclick="this.classList.toggle('active')">
              !
              <span class="tooltip-text">Game dev identity kept private for professional focus; details available upon request.</span>
            </span>
          </h4>
          <p>Built and published a PC game seen by 10M+ audience. Full development cycle from concept to shipping.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section>
    <div class="section-label reveal">Education</div>
    <h2 class="section-title reveal reveal-delay-1">Background</h2>
    <p class="section-sub reveal reveal-delay-2">Academic foundation that shaped my technical perspective.</p>
    <div class="timeline reveal reveal-delay-3">
      <div class="timeline-item">
        <div class="date">Sep 2022 — Jul 2025</div>
        <h3>B.Sc. Computer Science</h3>
        <div class="org">University of Pécs — Pécs, Hungary</div>
        <p>Software Developer track. Thesis on creating an aviation company data warehouse. Courses in Data Science, Introduction to AI, and Advanced Python.</p>
      </div>
      <div class="timeline-item">
        <div class="date">Sep 2020 — Jun 2022</div>
        <h3>International Baccalaureate Diploma</h3>
        <div class="org">ISTEK Schools — Istanbul, Turkey</div>
        <p>Higher Level Business Management and English. Foundation in analytical thinking and global perspectives.</p>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills">
    <div class="section-label reveal">Skills</div>
    <h2 class="section-title reveal reveal-delay-1">Toolkit & Languages</h2>
    <p class="section-sub reveal reveal-delay-2">Technologies I work with and the languages I speak.</p>
    <div class="skills-grid reveal reveal-delay-3">
      <div class="skill-group">
        <h3>Core Expertise</h3>
        <div class="skill-cluster">
          <span class="skill-chip prod">Data Architecture</span>
          <span class="skill-chip prod">Dimensional Modeling</span>
          <span class="skill-chip prod">Solution Design</span>
          <span class="skill-chip prod">Technical Strategy</span>
          <span class="skill-chip prod">Financial & Aviation Data Modeling</span>
          <span class="skill-chip freq">Python</span>
          <span class="skill-chip freq">Oracle</span>
          <span class="skill-chip freq">SQL Server</span>
          <span class="skill-chip freq">PowerDesigner</span>
          <span class="skill-chip freq">JavaScript / TypeScript</span>
          <span class="skill-chip exp">AI / ML</span>
          <span class="skill-chip exp">Software Architecture</span>
          <span class="skill-chip exp">ETL / Data Warehousing</span>
        </div>
      </div>
      <div class="skill-group">
        <h3>Languages</h3>
        <div class="skill-cluster" style="margin-bottom:24px;">
          <span class="skill-chip prod">English — Professional</span>
          <span class="skill-chip prod">Turkish — Native</span>
        </div>
        <h3 style="margin-top:24px;">Also Familiar With</h3>
        <div class="skill-cluster">
          <span class="skill-chip">Docker</span>
          <span class="skill-chip">Git</span>
          <span class="skill-chip">Linux</span>
          <span class="skill-chip">Excel</span>
          <span class="skill-chip">HTML / CSS</span>
          <span class="skill-chip">Unity</span>
          <span class="skill-chip">C#</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact-section">
    <div class="section-label reveal">Contact</div>
    <h2 class="section-title reveal reveal-delay-1">Get in Touch</h2>
    <p class="section-sub reveal reveal-delay-2" style="margin-bottom:32px;">Have a question or want to work together? Drop me a message.</p>
    <ContactForm />
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative; z-index: 1;
    min-height: 100vh; display: flex; align-items: center;
    padding: 120px 32px 80px;
    max-width: 1200px; margin: 0 auto;
  }

  .section-label {
    font-family: var(--mono); font-size: 12px;
    color: var(--accent); letter-spacing: 2px; text-transform: uppercase;
    margin-bottom: 8px;
  }
  .section-title {
    font-size: 28px; font-weight: 700; margin-bottom: 12px;
  }
  .section-sub {
    color: var(--text2); font-size: 15px; max-width: 600px;
    margin-bottom: 48px;
  }

  section {
    position: relative; z-index: 1;
    max-width: 1000px; margin: 0 auto;
    padding: 100px 32px;
  }

  .summary-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
  }
  .summary-grid p {
    font-size: 14px; color: var(--text2); line-height: 1.8;
  }
  .summary-grid strong { color: var(--text); }

  .timeline { position: relative; padding-left: 28px; }
  .timeline::before {
    content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px;
    width: 2px; background: var(--border);
  }
  .timeline-item {
    position: relative; margin-bottom: 40px; padding-left: 28px;
  }
  .timeline-item:last-child { margin-bottom: 0; }
  .timeline-item::before {
    content: ''; position: absolute;
    left: -21px; top: 6px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--accent);
  }
  .timeline-item .date {
    font-family: var(--mono); font-size: 12px;
    color: var(--accent); margin-bottom: 4px;
  }
  .timeline-item h3 { font-size: 16px; font-weight: 600; }
  .timeline-item .org {
    font-size: 13px; color: var(--accent2); margin-bottom: 8px;
  }
  .timeline-item p { font-size: 13px; color: var(--text2); line-height: 1.6; }
  .timeline-item .tech-tags {
    display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px;
  }
  .timeline-item .tech-tags span {
    padding: 2px 10px; border-radius: 6px;
    font-size: 11px; font-family: var(--mono);
    background: var(--surface2); color: var(--text2);
    border: 1px solid var(--border);
  }

  .side-projects {
    background: linear-gradient(135deg, rgba(167,139,250,0.05), rgba(96,165,250,0.05));
    border: 1px solid rgba(167,139,250,0.15);
    border-radius: var(--radius-lg);
    padding: 40px; margin-top: 48px;
  }
  .side-projects .badge {
    display: inline-block;
    padding: 3px 10px; border-radius: 6px;
    font-size: 11px; font-weight: 600;
    background: rgba(167,139,250,0.15); color: var(--accent2);
    margin-bottom: 12px;
  }
  .side-projects h3 {
    font-size: 18px; font-weight: 600; margin-bottom: 8px;
    color: var(--accent2);
  }
  .side-projects p { font-size: 13px; color: var(--text2); max-width: 600px; }

  .side-project-card {
    display: flex; gap: 20px; align-items: center;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px;
    margin-top: 16px;
    transition: all 0.2s;
  }
  .side-project-card:hover {
    border-color: rgba(167,139,250,0.3);
    transform: translateX(4px);
  }
  .side-project-card .thumb {
    width: 56px; height: 56px; border-radius: 10px;
    background: var(--surface2); display: flex;
    align-items: center; justify-content: center;
    font-size: 24px; flex-shrink: 0;
  }
  .side-project-card .info h4 {
    font-size: 14px; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
  }
  .side-project-card .info p { font-size: 12px; color: var(--text2); margin-top: 2px; }

  .private-note {
    position: relative;
    font-size: 10px;
    width: 16px; height: 16px;
    border: 1px solid var(--accent2);
    color: var(--accent2);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: rgba(167,139,250,0.1);
    font-weight: bold;
  }
  .tooltip-text {
    visibility: hidden;
    width: 200px;
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 8px;
    border-radius: 6px;
    position: absolute;
    z-index: 1;
    bottom: 125%;
    left: 50%;
    margin-left: -100px;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .private-note.active .tooltip-text {
    visibility: visible;
    opacity: 1;
  }

  .skills-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 32px;
  }
  .skill-group h3 {
    font-size: 13px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 1px; color: var(--text2);
    margin-bottom: 16px;
  }
  .skill-cluster { display: flex; flex-wrap: wrap; gap: 8px; }
  .skill-chip {
    padding: 6px 14px; border-radius: 8px;
    font-size: 13px; font-weight: 500;
    background: var(--surface2); color: var(--text);
    border: 1px solid var(--border);
    transition: all 0.2s;
  }
  .skill-chip:hover {
    border-color: var(--accent); color: var(--accent);
    transform: translateY(-1px);
  }
  .skill-chip.prod { border-color: rgba(96,165,250,0.3); }
  .skill-chip.freq { border-color: rgba(167,139,250,0.3); }
  .skill-chip.exp { border-color: rgba(52,211,153,0.3); }

  .contact-section {
    padding-bottom: 40px;
  }

  .reveal {
    opacity: 0; transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22,1,0.36,1);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  @media (max-width: 768px) {
    .hero { padding: 100px 20px 60px; min-height: auto; }
    section { padding: 60px 20px; }
    .summary-grid { grid-template-columns: 1fr; }
    .skills-grid { grid-template-columns: 1fr; }
    .side-project-card { flex-direction: column; text-align: center; }
  }
</style>

<script>
  document.addEventListener('contextmenu', e => e.preventDefault());
  document.addEventListener('dragstart', e => {
    if (e.target.tagName === 'IMG') e.preventDefault();
  });
</script>
