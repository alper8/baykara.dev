<div class="contact-grid">
  <div class="contact-info">
    <h3>Let's build something</h3>
    <p>Whether it's a data architecture challenge, a system design problem, or just a chat about tech — I'm always open to interesting conversations.</p>
    <div class="contact-links">
      <a href="mailto:hello@baykara.dev" class="contact-link">
        <span class="icon">✉</span> hello@baykara.dev
      </a>
      <a href="https://www.linkedin.com/in/alper-baykara/" class="contact-link" target="_blank">
        <span class="icon">▣</span> LinkedIn
      </a>
      <a href="https://github.com/alper8" class="contact-link" target="_blank">
        <span class="icon">⎔</span> GitHub
      </a>
    </div>
  </div>

  <form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value="37732c5b-b41b-47b0-933a-3a6c31f26714" />
    <input type="hidden" name="from_name" value="baykara.dev Contact Form" />

    <input type="text" name="name" placeholder="Your name" required />
    <input type="email" name="email" placeholder="Email" required />
    <input type="text" name="subject" placeholder="Subject" />
    <textarea name="message" placeholder="Your message..." required></textarea>

    <div class="h-captcha" data-captcha="true"></div>

    <button type="submit">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9"/></svg>
      <span>Send Message</span>
    </button>
  </form>
</div>

<script src="https://web3forms.com/client/script.js" async defer></script>
<script>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      const hCaptcha = form.querySelector('textarea[name=h-captcha-response]');
      const value = hCaptcha ? hCaptcha.value : '';
      if (!value) {
        e.preventDefault();
        alert('Please complete the captcha verification.');
      }
    });
  }
</script>

