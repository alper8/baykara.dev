---
import Icon from './Icon.astro';
---

<section class="contact-section">
	<div class="contact-card">
		<div class="contact-header">
			<Icon icon="paper-plane-tilt" color="var(--accent-dark)" size="2rem" />
			<h2>Get in Touch</h2>
			<p>Have a question or want to work together? Drop me a message.</p>
		</div>

		<form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
			<input type="hidden" name="access_key" value="37732c5b-b41b-47b0-933a-3a6c31f26714" />
			<input type="hidden" name="from_name" value="baykara.dev Contact Form" />

			<div class="form-row">
				<div class="form-group">
					<label for="name">Name</label>
					<input type="text" id="name" name="name" required placeholder="Your name" />
				</div>
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" required placeholder="your@email.com" />
				</div>
			</div>

			<div class="form-group">
				<label for="subject">Subject</label>
				<input type="text" id="subject" name="subject" required placeholder="What's this about?" />
			</div>

			<div class="form-group">
				<label for="message">Message</label>
				<textarea id="message" name="message" rows="5" required placeholder="Your message..."></textarea>
			</div>

			<div class="h-captcha" data-captcha="true"></div>

			<button type="submit">
				<span>Send Message</span>
				<Icon icon="paper-plane-tilt" size="1.2em" />
			</button>
		</form>
	</div>
</section>

<script src="https://web3forms.com/client/script.js" async defer></script>
<script>
	const form = document.getElementById('contact-form');

	if (form) {
		form.addEventListener('submit', function(e) {
			const hCaptcha = form.querySelector('textarea[name=h-captcha-response]');
			const value = hCaptcha ? (hCaptcha as HTMLTextAreaElement).value : '';

			if (!value) {
				e.preventDefault();
				alert('Please complete the captcha verification.');
				return;
			}
		});
	}
</script>

<style>
	.contact-section {
		padding: 5rem 1.5rem;
		border-top: 1px solid var(--gray-800);
		background-color: var(--gray-999_40);
	}

	.contact-card {
		max-width: 42rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.contact-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.contact-header h2 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.1;
	}

	.contact-header p {
		font-size: var(--text-base);
		color: var(--gray-400);
		line-height: 1.6;
		max-width: 32ch;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-row {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--gray-200);
		letter-spacing: 0.02em;
	}

	input,
	textarea {
		padding: 0.875rem 1rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		background-color: var(--gray-999);
		color: var(--gray-0);
		font-family: var(--font-body);
		font-size: var(--text-base);
		line-height: 1.5;
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			background-color var(--theme-transition);
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--gray-600);
	}

	input:hover,
	textarea:hover {
		border-color: var(--gray-700);
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--accent-regular);
		background-color: var(--gray-999);
		box-shadow:
			0 0 0 3px var(--accent-overlay),
			0 0 0 1px var(--accent-regular);
	}

	textarea {
		resize: vertical;
		min-height: 9rem;
	}

	button {
		position: relative;
		display: inline-flex;
		place-content: center;
		align-items: center;
		text-align: center;
		padding: 0.875rem 2.25rem;
		gap: 0.75em;
		color: var(--accent-text-over);
		text-decoration: none;
		line-height: 1.1;
		border: none;
		border-radius: 999rem;
		overflow: hidden;
		background: var(--gradient-accent-orange);
		box-shadow: var(--shadow-md);
		white-space: nowrap;
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-base);
		cursor: pointer;
		align-self: flex-start;
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
	}

	button:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-lg);
	}

	button:active {
		transform: translateY(0);
	}

	button::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: background-color var(--theme-transition);
		mix-blend-mode: overlay;
	}

	button:focus-visible::after,
	button:hover::after {
		background-color: hsla(var(--gray-999-basis), 0.3);
	}

	button span {
		position: relative;
		z-index: 1;
	}

	.h-captcha {
		display: flex;
		justify-content: flex-start;
	}

	@media (min-width: 40em) {
		.form-row {
			flex-direction: row;
			gap: 1rem;
		}

		.form-row .form-group {
			flex: 1;
		}

		button {
			padding: 1rem 2.75rem;
			font-size: var(--text-lg);
		}
	}

	@media (min-width: 50em) {
		.contact-section {
			padding: 8rem 2rem;
		}

		.contact-header h2 {
			font-size: var(--text-4xl);
		}

		.contact-header p {
			font-size: var(--text-lg);
		}

		form {
			gap: 1.5rem;
		}

		.form-row {
			gap: 1.25rem;
		}

		input,
		textarea {
			padding: 1rem 1.25rem;
		}

		button {
			padding: 1.125rem 3rem;
			font-size: var(--text-xl);
		}
	}
</style>